# .env.example - environment variables for local development
# Make a copy of this file named .env and fill in the values.

# PostgreSQL database connection string
DATABASE_URL="postgres://user:password@localhost:5432/database_name?sslmode=disable"

# JWT secret for signing tokens. Use a long, random string.
JWT_SECRET="your_jwt_secret"

# Server port
SERVER_PORT=":8080"

# Empty by default: ignore forwarded IP headers from direct clients.
# Set only the CIDRs of reverse proxies that connect to this API.
TRUSTED_PROXY_CIDRS=""

# Initial Admin User (optional)
# Public registration creates customers. Use these settings to bootstrap an admin.
# Existing accounts retain their password and active status on subsequent starts.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=""
ADMIN_LAST_NAME=""
